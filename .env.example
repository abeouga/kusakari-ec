KUSAKARI_EC_DB_USER=kusakari
KUSAKARI_EC_DB_PASSWORD=
KUSAKARI_EC_DATABASE_MODE=existing
KUSAKARI_EC_DB_PORT=3306
KUSAKARI_EC_DB_URL=jdbc:mysql://127.0.0.1:3306/kusakari?connectionTimeZone=UTC
KUSAKARI_EC_E2E_DB_URL=jdbc:mysql://127.0.0.1:3306/kusakari_e2e?connectionTimeZone=UTC

# Canvas workspace
VITE_KUSAKARI_CANVAS_URL=http://127.0.0.1:5173/
KUSAKARI_CANVAS_API_URL=http://127.0.0.1:8080

# Product plant-feature suggestions (server only)
KUSAKARI_EC_OPENAI_API_KEY=
KUSAKARI_EC_PLANT_SUGGESTION_MODEL=gpt-6-luna
# Optional paid E2E. Never falls back to the development key.
# KUSAKARI_EC_E2E_OPENAI_API_KEY=

# Run setup.bat first, then node scripts/configure-cognito.mjs (see docs/cognito-setup.md).
# Public shared-pool values are tracked in config/cognito.development.json.
# No AWS management credentials are needed for application login.
# SPRING_PROFILES_ACTIVE=cognito
# KUSAKARI_COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/USER_POOL_ID
# KUSAKARI_COGNITO_DOMAIN=https://YOUR_DOMAIN.auth.ap-northeast-1.amazoncognito.com
# KUSAKARI_COGNITO_CLIENT_ID=
