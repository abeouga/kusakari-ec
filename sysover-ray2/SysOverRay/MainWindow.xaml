<Window x:Class="KusakariEcSysOverRay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kusakari 起動オーバーレイ"
        Width="360"
        Height="300"
        MinWidth="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border x:Name="WindowBorder"
            Margin="12"
            Padding="0"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderArea" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="HeaderArea_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="16,10,0,6">
                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="Bold">KUSAKARI CONTROL</TextBlock>
                    <TextBlock x:Name="SummaryText" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10">状態を確認しています</TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,7,8,7" Orientation="Horizontal">
                    <Button x:Name="PinButton" Style="{StaticResource IconButtonStyle}" Content="●" ToolTip="常に手前に表示" Click="PinButton_Click" />
                    <Button x:Name="CompactButton" Style="{StaticResource IconButtonStyle}" Content="⌃" ToolTip="折りたたむ" Click="CompactButton_Click" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="×" ToolTip="タスクトレイに隠す" Click="HideButton_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ExpandedPanel" Grid.Row="1" Margin="14,2,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,10" Background="{StaticResource CardBrush}" CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="BackendDot" Grid.Column="0" Width="8" Height="8" Fill="#FF707786" />
                        <TextBlock x:Name="BackendLabel" Grid.Column="1" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">API</TextBlock>
                        <TextBlock x:Name="BackendStatusText" Grid.Column="2" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center">確認中</TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,6,0,0" Padding="12,10" Background="{StaticResource CardBrush}" CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="FrontendDot" Grid.Column="0" Width="8" Height="8" Fill="#FF707786" />
                        <TextBlock x:Name="FrontendLabel" Grid.Column="1" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">Web</TextBlock>
                        <TextBlock x:Name="FrontendStatusText" Grid.Column="2" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center">確認中</TextBlock>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Content="▶  起動" Click="StartButton_Click" />
                    <Button x:Name="RestartButton" Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Background="{StaticResource AccentBrush}" Content="↻  再起動" Click="RestartButton_Click" />
                    <Button x:Name="StopButton" Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Content="■  停止" Click="StopButton_Click" />
                </Grid>

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Padding="10,7" FontSize="11" FontWeight="Normal" Content="ブラウザを開く" Click="OpenBrowserButton_Click" />
                    <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Padding="10,7" FontSize="11" FontWeight="Normal" Content="ログを開く" Click="OpenLogsButton_Click" />
                </Grid>

                <TextBlock x:Name="LastActionText"
                           Grid.Row="7"
                           Margin="2,10,2,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Bottom">このKusakariの起動・停止・再起動</TextBlock>
            </Grid>

            <Grid x:Name="CompactPanel" Grid.Row="1" Margin="14,0,14,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="CompactBackendDot" Grid.Column="0" Margin="2,0,8,0" Width="8" Height="8" Fill="#FF707786" />
                <Ellipse x:Name="CompactFrontendDot" Grid.Column="1" Margin="0,0,10,0" Width="8" Height="8" Fill="#FF707786" />
                <TextBlock x:Name="CompactStatusText" Grid.Column="2" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center">確認中</TextBlock>
                <Button x:Name="CompactRestartButton" Grid.Column="3" Style="{StaticResource ActionButtonStyle}" Background="{StaticResource AccentBrush}" Padding="13,7" Content="↻  再起動" Click="RestartButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
